import { useEffect, useState } from 'react'
import { Navigate, useNavigate } from 'react-router-dom'
import { userPool } from '../auth/cognito.js'

const STORAGE_KEY = 'ddimmigration_promoter_application_status'
const REFERRAL_CODE_STORAGE_KEY = 'ddimmigration_promoter_referral_code'
const APPLY_PROMOTER_API_URL = 'https://rpy63sy084.execute-api.ap-southeast-2.amazonaws.com/default/applyPromoter'
const VISA_PORTAL_PROFILE_API_URL =
  'https://kv8yy4iiyg.execute-api.ap-southeast-2.amazonaws.com/default/portalVisaProfile'
const SHOW_MY_REFERRALS_API_URL =
  'https://la0omw3xia.execute-api.ap-southeast-2.amazonaws.com/default/showMyReferrals'
const CHANNEL_OPTIONS = ['朋友圈', '微信群', '小红书', '抖音', '熟人介绍', '其他']

const makeReferralLink = (code) => {
  if (!code) return ''
  return `https://nzddvisa.com/visa-portal/login?ref=${encodeURIComponent(code)}`
}

const displayValue = (value) => {
  const text = String(value || '').trim()
  return text || '-'
}

const formatTime = (value) => {
  if (!value) return '-'
  const date = new Date(value)
  if (Number.isNaN(date.getTime())) return displayValue(value)
  return date.toLocaleString('zh-CN', { hour12: false })
}

function PromoterRegisterPage() {
  const navigate = useNavigate()
  const [sessionState, setSessionState] = useState(() => ({
    loading: Boolean(userPool.getCurrentUser()),
    authenticated: false,
    username: '',
    email: '',
  }))
  const [form, setForm] = useState({
    name: '',
    wechat: '',
    phone: '',
    channels: ['朋友圈'],
    note: '',
  })
  const [approved, setApproved] = useState(false)
  const [referralCode, setReferralCode] = useState('')
  const [submitState, setSubmitState] = useState({ loading: false, error: '' })
  const [copySuccess, setCopySuccess] = useState(false)
  const [myReferrals, setMyReferrals] = useState([])
  const [myReferralsState, setMyReferralsState] = useState({
    loading: false,
    loaded: false,
    error: '',
  })
  const referralLink = makeReferralLink(referralCode)

  const loadMyReferrals = () => {
    if (!SHOW_MY_REFERRALS_API_URL) {
      setMyReferrals([])
      setMyReferralsState({ loading: false, loaded: true, error: '' })
      return
    }

    const currentUser = userPool.getCurrentUser()
    if (!currentUser) {
      setMyReferralsState({ loading: false, loaded: false, error: '登录状态已过期，请重新登录。' })
      return
    }

    setMyReferralsState({ loading: true, loaded: false, error: '' })
    currentUser.getSession(async (sessionError, session) => {
      if (sessionError || !session?.isValid()) {
        setMyReferralsState({ loading: false, loaded: false, error: '登录状态已过期，请重新登录。' })
        return
      }

      try {
        const response = await fetch(SHOW_MY_REFERRALS_API_URL, {
          headers: {
            Authorization: session.getIdToken().getJwtToken(),
          },
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok || data?.ok === false) {
          throw new Error(data?.message || data?.error || `HTTP ${response.status}`)
        }

        const items = Array.isArray(data?.items) ? data.items : Array.isArray(data) ? data : []
        setMyReferrals(items)
        setMyReferralsState({ loading: false, loaded: true, error: '' })
      } catch (error) {
        setMyReferralsState({
          loading: false,
          loaded: false,
          error: error?.message || '推荐客户加载失败，请稍后再试。',
        })
      }
    })
  }

  const handleCopyReferralLink = async () => {
    if (!referralLink) return

    try {
      await navigator.clipboard?.writeText(referralLink)
      setCopySuccess(true)
      window.setTimeout(() => setCopySuccess(false), 1800)
    } catch {
      setCopySuccess(false)
    }
  }

  useEffect(() => {
    const currentUser = userPool.getCurrentUser()
    if (!currentUser) {
      setSessionState((current) => ({ ...current, loading: false }))
      return undefined
    }

    currentUser.getSession((error, session) => {
      if (error || !session?.isValid()) {
        setSessionState((current) => ({ ...current, loading: false }))
        return
      }
      const payload = session.getIdToken().payload || {}
      setSessionState({
        loading: false,
        authenticated: true,
        username: payload['cognito:username'] || currentUser.getUsername(),
        email: payload.email || '',
      })

      fetch(VISA_PORTAL_PROFILE_API_URL, {
        headers: {
          Authorization: session.getIdToken().getJwtToken(),
        },
      })
        .then((response) => response.json().catch(() => ({})))
        .then((data) => {
          const profile = data?.item || data
          const nextApproved = profile?.promoterStatus === 'approved'
          const nextReferralCode = nextApproved ? profile?.referralCode || '' : ''

          if (nextApproved) {
            localStorage.setItem(STORAGE_KEY, 'approved')
            if (nextReferralCode) {
              localStorage.setItem(REFERRAL_CODE_STORAGE_KEY, nextReferralCode)
            }
          } else {
            localStorage.removeItem(STORAGE_KEY)
            localStorage.removeItem(REFERRAL_CODE_STORAGE_KEY)
          }

          setApproved(nextApproved)
          setReferralCode(nextReferralCode)
        })
        .catch(() => undefined)
    })
    return undefined
  }, [])

  useEffect(() => {
    if (!approved || myReferralsState.loaded || myReferralsState.loading) return
    loadMyReferrals()
  }, [approved, myReferralsState.loaded, myReferralsState.loading])

  const updateField = (field, value) => {
    setForm((current) => ({ ...current, [field]: value }))
  }

  const toggleChannel = (channel) => {
    setForm((current) => {
      const channels = current.channels.includes(channel)
        ? current.channels.filter((item) => item !== channel)
        : [...current.channels, channel]
      return { ...current, channels }
    })
  }

  const handleSubmit = (event) => {
    event.preventDefault()
    setSubmitState({ loading: true, error: '' })

    const currentUser = userPool.getCurrentUser()
    if (!currentUser) {
      setSubmitState({ loading: false, error: '登录状态已过期，请重新登录后再提交。' })
      return
    }

    currentUser.getSession(async (sessionError, session) => {
      if (sessionError || !session?.isValid()) {
        setSubmitState({ loading: false, error: '登录状态已过期，请重新登录后再提交。' })
        return
      }

      try {
        const response = await fetch(APPLY_PROMOTER_API_URL, {
          method: 'POST',
          headers: {
            Authorization: session.getIdToken().getJwtToken(),
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            name: form.name.trim(),
            wechat: form.wechat.trim(),
            phone: form.phone.trim(),
            channels: form.channels,
            note: form.note.trim(),
          }),
        })
        const data = await response.json().catch(() => ({}))

        if (!response.ok || data?.success === false) {
          throw new Error(data?.message || '提交失败，请稍后再试。')
        }

        const nextReferralCode = data?.referralCode || ''
        localStorage.setItem(STORAGE_KEY, 'approved')
        if (nextReferralCode) {
          localStorage.setItem(REFERRAL_CODE_STORAGE_KEY, nextReferralCode)
        }
        setReferralCode(nextReferralCode)
        setApproved(true)
        setSubmitState({ loading: false, error: '' })
      } catch (error) {
        setSubmitState({ loading: false, error: error?.message || '提交失败，请稍后再试。' })
      }
    })
  }

  if (sessionState.loading) {
    return <main className="visa-portal-page"><p className="visa-portal-loading">正在验证登录状态...</p></main>
  }
  if (!sessionState.authenticated) {
    return <Navigate to="/visa-portal/login?returnTo=/promoter-register" replace />
  }

  return (
    <main className="visa-portal-page">
      <section className="promoter-apply-shell">
        <header className="visa-portal-dashboard-head">
          <div>
            <p className="visa-portal-eyebrow">DD Immigration Promoter</p>
            <h1>申请成为推广员</h1>
            <p>您好，{sessionState.username}{sessionState.email ? `（${sessionState.email}）` : ''}</p>
          </div>
          <button type="button" className="visa-portal-secondary-btn" onClick={() => navigate('/visa-portal')}>返回客户中心</button>
        </header>

        {approved ? (
          <section className="promoter-apply-success">
            <section className="promoter-success-card">
              <h2>已成为推广员</h2>
              {referralCode && <p>您的推荐码：{referralCode}</p>}
              {referralLink && (
                <div className="promoter-referral-link">
                  <span>您的推广链接</span>
                  <div className="promoter-referral-link-row">
                    <input type="text" value={referralLink} readOnly />
                    <button
                      type="button"
                      className={`visa-portal-secondary-btn promoter-copy-btn${copySuccess ? ' copied' : ''}`}
                      onClick={handleCopyReferralLink}
                    >
                      {copySuccess ? '复制成功' : '复制链接'}
                    </button>
                  </div>
                </div>
              )}
              <div className="promoter-helper-wechat">
                <div>
                  <h3>添加推广小助手微信</h3>
                  <p>扫码添加后，可以咨询推荐流程、客户登记和推广链接使用方式。</p>
                </div>
                <img src="/pic/qrcodevx1.jpg" alt="推广小助手微信二维码" />
              </div>
            </section>
            <section className="promoter-referral-clients">
              <div className="promoter-referral-clients-head">
                <div>
                  <h3>我的推荐客户</h3>
                  <p>通过您的推广链接注册并绑定的客户，会显示在这里。</p>
                </div>
                <button
                  type="button"
                  className="visa-portal-secondary-btn"
                  onClick={loadMyReferrals}
                  disabled={myReferralsState.loading || !SHOW_MY_REFERRALS_API_URL}
                >
                  {myReferralsState.loading ? '刷新中...' : '刷新'}
                </button>
              </div>
              {!SHOW_MY_REFERRALS_API_URL ? (
                <p className="promoter-referral-empty">推荐客户列表接口接入后，这里会显示您的推荐客户。</p>
              ) : myReferralsState.error ? (
                <p className="visa-portal-status visa-portal-status--error">{myReferralsState.error}</p>
              ) : myReferralsState.loading ? (
                <p className="promoter-referral-empty">正在加载推荐客户...</p>
              ) : myReferrals.length === 0 ? (
                <p className="promoter-referral-empty">当前暂无已绑定的推荐客户。</p>
              ) : (
                <div className="promoter-referral-client-list">
                  {myReferrals.map((item) => (
                    <article
                      className="promoter-referral-client-card"
                      key={item.referralId || item.referredProfileId || item.referredEmail}
                    >
                      <div>
                        <strong>{displayValue(item.referredUsername || item.clientName)}</strong>
                        <span>{displayValue(item.referredEmail || item.ownerEmail)}</span>
                      </div>
                      <time>{formatTime(item.createdAt || item.referredAt)}</time>
                    </article>
                  ))}
                </div>
              )}
            </section>
            <div className="promoter-apply-actions">
              <button type="button" className="visa-portal-secondary-btn" onClick={() => navigate('/promoter')}>查看推广介绍页</button>
            </div>
          </section>
        ) : (
          <form className="promoter-apply-form" onSubmit={handleSubmit}>
            <div className="promoter-apply-intro">
              <h2>推广员申请资料</h2>
              <p>提交后会直接开通推广员身份，并生成您的专属推荐码。</p>
            </div>

            <label className="visa-portal-field">
              <span>姓名</span>
              <input
                type="text"
                value={form.name}
                onChange={(event) => updateField('name', event.target.value)}
                placeholder="请输入您的姓名"
                required
              />
            </label>

            <label className="visa-portal-field">
              <span>微信号</span>
              <input
                type="text"
                value={form.wechat}
                onChange={(event) => updateField('wechat', event.target.value)}
                placeholder="请输入微信号"
              />
            </label>

            <label className="visa-portal-field">
              <span>手机号</span>
              <input
                type="tel"
                value={form.phone}
                onChange={(event) => updateField('phone', event.target.value)}
                placeholder="请输入手机号"
              />
            </label>

            <div className="visa-portal-field">
              <span>主要推广渠道</span>
              <div className="promoter-channel-options">
                {CHANNEL_OPTIONS.map((option) => (
                  <label key={option} className="promoter-channel-option">
                    <input
                      type="checkbox"
                      checked={form.channels.includes(option)}
                      onChange={() => toggleChannel(option)}
                    />
                    <span>{option}</span>
                  </label>
                ))}
              </div>
            </div>

            <label className="visa-portal-field">
              <span>客户资源说明</span>
              <textarea
                value={form.note}
                onChange={(event) => updateField('note', event.target.value)}
                placeholder="例如：身边有想咨询新西兰留学、出国劳务、签证办理或移民规划的朋友。"
                rows={5}
              />
            </label>

            {submitState.error && <p className="visa-portal-status visa-portal-status--error">{submitState.error}</p>}

            <button type="submit" className="visa-portal-primary-btn" disabled={submitState.loading}>
              {submitState.loading ? '正在提交...' : '提交申请'}
            </button>
          </form>
        )}
      </section>
    </main>
  )
}

export default PromoterRegisterPage
