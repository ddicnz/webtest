import { useEffect, useState } from 'react'
import { Navigate, useNavigate } from 'react-router-dom'
import { userPool } from '../auth/cognito.js'

const VISA_PORTAL_PROFILE_API_URL =
  'https://kv8yy4iiyg.execute-api.ap-southeast-2.amazonaws.com/default/portalVisaProfile'

function VisaPortalPage() {
  const navigate = useNavigate()
  const [sessionState, setSessionState] = useState(() => ({
    loading: Boolean(userPool.getCurrentUser()),
    authenticated: false,
    username: '',
    email: '',
  }))
  const [promoterState, setPromoterState] = useState(() => ({
    loading: false,
    status: localStorage.getItem('ddimmigration_promoter_application_status') || '',
    referralCode: localStorage.getItem('ddimmigration_promoter_referral_code') || '',
  }))

  useEffect(() => {
    const currentUser = userPool.getCurrentUser()
    if (!currentUser) return undefined

    currentUser.getSession((error, session) => {
      if (error || !session?.isValid()) {
        setSessionState((current) => ({ ...current, loading: false }))
        return
      }
      const payload = session.getIdToken().payload || {}
      setSessionState({
        loading: false,
        authenticated: true,
        username: payload['cognito:username'] || currentUser.getUsername(),
        email: payload.email || '',
      })

      setPromoterState((current) => ({ ...current, loading: true }))
      fetch(VISA_PORTAL_PROFILE_API_URL, {
        headers: {
          Authorization: session.getIdToken().getJwtToken(),
        },
      })
        .then((response) => response.json().catch(() => ({})))
        .then((data) => {
          const profile = data?.item || data
          const nextStatus = profile?.promoterStatus || ''
          const nextReferralCode = profile?.referralCode || ''

          if (nextStatus) {
            localStorage.setItem('ddimmigration_promoter_application_status', nextStatus)
          }
          if (nextReferralCode) {
            localStorage.setItem('ddimmigration_promoter_referral_code', nextReferralCode)
          }

          setPromoterState((current) => ({
            loading: false,
            status: nextStatus || current.status,
            referralCode: nextReferralCode || current.referralCode,
          }))
        })
        .catch(() => {
          setPromoterState((current) => ({ ...current, loading: false }))
        })
    })
    return undefined
  }, [])

  const handleLogout = () => {
    userPool.getCurrentUser()?.signOut()
    navigate('/visa-portal/login', { replace: true })
  }

  const isPromoterApproved = promoterState.status === 'approved'
  const isPromoterPending = promoterState.status === 'pending'

  if (sessionState.loading) {
    return <main className="visa-portal-page"><p className="visa-portal-loading">正在验证登录状态...</p></main>
  }
  if (!sessionState.authenticated) return <Navigate to="/visa-portal/login" replace />

  return (
    <main className="visa-portal-page">
      <section className="visa-portal-dashboard">
        <header className="visa-portal-dashboard-head">
          <div>
            <p className="visa-portal-eyebrow">DD Immigration Client Portal</p>
            <h1>签证客户资料中心</h1>
            <p>您好，{sessionState.username}{sessionState.email ? `（${sessionState.email}）` : ''}</p>
          </div>
          <button type="button" className="visa-portal-secondary-btn" onClick={handleLogout}>退出登录</button>
        </header>
        <div className="visa-portal-dashboard-grid">
          <section className="visa-portal-dashboard-item">
            <h2>个人信息表</h2>
            <p>查看并继续完善您的签证个人信息。</p>
            <button
              type="button"
              className="visa-portal-entry-btn"
              onClick={() => navigate('/visa-portal/info-form')}
            >
              填写/继续填写
            </button>
          </section>
          <section className="visa-portal-dashboard-item">
            <h2>签证材料</h2>
            <p>上传护照、工作、学历及家庭相关材料。</p>
            <button
              type="button"
              className="visa-portal-entry-btn"
              onClick={() => navigate('/visa-portal/materials')}
            >
              上传材料
            </button>
          </section>
          <section className="visa-portal-dashboard-item">
            <h2>材料进度</h2>
            <p>查看材料审核状态与顾问补充说明。</p>
            <span>即将开放</span>
          </section>
          <section className="visa-portal-dashboard-item visa-portal-dashboard-item--promoter">
            <h2>{isPromoterApproved ? '推广员中心' : (isPromoterPending ? '推广员申请' : '成为推广员')}</h2>
            <p>
              {promoterState.loading
                ? '正在读取推广员状态...'
                : (isPromoterApproved
                  ? `您已成为推广员${promoterState.referralCode ? `，推荐码：${promoterState.referralCode}` : '。'}`
                  : (isPromoterPending ? '您的推广员申请已提交，等待后台审核。' : '申请成为推广员，获取专属推荐链接。'))}
            </p>
            <button
              type="button"
              className="visa-portal-entry-btn"
              onClick={() => navigate('/promoter-register')}
            >
              {isPromoterApproved ? '查看资料' : (isPromoterPending ? '查看申请' : '立即申请')}
            </button>
          </section>
        </div>
      </section>
    </main>
  )
}

export default VisaPortalPage
