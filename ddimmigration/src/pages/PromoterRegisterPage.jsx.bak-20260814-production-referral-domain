import { useEffect, useState } from 'react'
import { Navigate, useNavigate } from 'react-router-dom'
import { userPool } from '../auth/cognito.js'

const STORAGE_KEY = 'ddimmigration_promoter_application_status'
const REFERRAL_CODE_STORAGE_KEY = 'ddimmigration_promoter_referral_code'
const APPLY_PROMOTER_API_URL = 'https://rpy63sy084.execute-api.ap-southeast-2.amazonaws.com/default/applyPromoter'
const VISA_PORTAL_PROFILE_API_URL =
  'https://kv8yy4iiyg.execute-api.ap-southeast-2.amazonaws.com/default/portalVisaProfile'
const CHANNEL_OPTIONS = ['朋友圈', '微信群', '小红书', '抖音', '熟人介绍', '其他']

const makeReferralLink = (code) => {
  if (!code) return ''
  const origin = typeof window !== 'undefined' ? window.location.origin : 'https://nzdvisa.com'
  return `${origin}/visa-portal/login?ref=${encodeURIComponent(code)}`
}

function PromoterRegisterPage() {
  const navigate = useNavigate()
  const [sessionState, setSessionState] = useState(() => ({
    loading: Boolean(userPool.getCurrentUser()),
    authenticated: false,
    username: '',
    email: '',
  }))
  const [form, setForm] = useState({
    wechat: '',
    phone: '',
    channels: ['朋友圈'],
    note: '',
  })
  const [approved, setApproved] = useState(false)
  const [referralCode, setReferralCode] = useState('')
  const [submitState, setSubmitState] = useState({ loading: false, error: '' })
  const referralLink = makeReferralLink(referralCode)

  useEffect(() => {
    const currentUser = userPool.getCurrentUser()
    if (!currentUser) {
      setSessionState((current) => ({ ...current, loading: false }))
      return undefined
    }

    currentUser.getSession((error, session) => {
      if (error || !session?.isValid()) {
        setSessionState((current) => ({ ...current, loading: false }))
        return
      }
      const payload = session.getIdToken().payload || {}
      setSessionState({
        loading: false,
        authenticated: true,
        username: payload['cognito:username'] || currentUser.getUsername(),
        email: payload.email || '',
      })

      fetch(VISA_PORTAL_PROFILE_API_URL, {
        headers: {
          Authorization: session.getIdToken().getJwtToken(),
        },
      })
        .then((response) => response.json().catch(() => ({})))
        .then((data) => {
          const profile = data?.item || data
          const nextApproved = profile?.promoterStatus === 'approved'
          const nextReferralCode = nextApproved ? profile?.referralCode || '' : ''

          if (nextApproved) {
            localStorage.setItem(STORAGE_KEY, 'approved')
            if (nextReferralCode) {
              localStorage.setItem(REFERRAL_CODE_STORAGE_KEY, nextReferralCode)
            }
          } else {
            localStorage.removeItem(STORAGE_KEY)
            localStorage.removeItem(REFERRAL_CODE_STORAGE_KEY)
          }

          setApproved(nextApproved)
          setReferralCode(nextReferralCode)
        })
        .catch(() => undefined)
    })
    return undefined
  }, [])

  const updateField = (field, value) => {
    setForm((current) => ({ ...current, [field]: value }))
  }

  const toggleChannel = (channel) => {
    setForm((current) => {
      const channels = current.channels.includes(channel)
        ? current.channels.filter((item) => item !== channel)
        : [...current.channels, channel]
      return { ...current, channels }
    })
  }

  const handleSubmit = (event) => {
    event.preventDefault()
    setSubmitState({ loading: true, error: '' })

    const currentUser = userPool.getCurrentUser()
    if (!currentUser) {
      setSubmitState({ loading: false, error: '登录状态已过期，请重新登录后再提交。' })
      return
    }

    currentUser.getSession(async (sessionError, session) => {
      if (sessionError || !session?.isValid()) {
        setSubmitState({ loading: false, error: '登录状态已过期，请重新登录后再提交。' })
        return
      }

      try {
        const response = await fetch(APPLY_PROMOTER_API_URL, {
          method: 'POST',
          headers: {
            Authorization: session.getIdToken().getJwtToken(),
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            wechat: form.wechat.trim(),
            phone: form.phone.trim(),
            channels: form.channels,
            note: form.note.trim(),
          }),
        })
        const data = await response.json().catch(() => ({}))

        if (!response.ok || data?.success === false) {
          throw new Error(data?.message || '提交失败，请稍后再试。')
        }

        const nextReferralCode = data?.referralCode || ''
        localStorage.setItem(STORAGE_KEY, 'approved')
        if (nextReferralCode) {
          localStorage.setItem(REFERRAL_CODE_STORAGE_KEY, nextReferralCode)
        }
        setReferralCode(nextReferralCode)
        setApproved(true)
        setSubmitState({ loading: false, error: '' })
      } catch (error) {
        setSubmitState({ loading: false, error: error?.message || '提交失败，请稍后再试。' })
      }
    })
  }

  if (sessionState.loading) {
    return <main className="visa-portal-page"><p className="visa-portal-loading">正在验证登录状态...</p></main>
  }
  if (!sessionState.authenticated) {
    return <Navigate to="/visa-portal/login?returnTo=/promoter-register" replace />
  }

  return (
    <main className="visa-portal-page">
      <section className="promoter-apply-shell">
        <header className="visa-portal-dashboard-head">
          <div>
            <p className="visa-portal-eyebrow">DD Immigration Promoter</p>
            <h1>申请成为推广员</h1>
            <p>您好，{sessionState.username}{sessionState.email ? `（${sessionState.email}）` : ''}</p>
          </div>
          <button type="button" className="visa-portal-secondary-btn" onClick={() => navigate('/visa-portal')}>返回客户中心</button>
        </header>

        {approved ? (
          <section className="promoter-apply-success">
            <h2>已成为推广员</h2>
            {referralCode && <p>您的推荐码：{referralCode}</p>}
            {referralLink && (
              <div className="promoter-referral-link">
                <span>您的推广链接</span>
                <input type="text" value={referralLink} readOnly />
                <button
                  type="button"
                  className="visa-portal-secondary-btn"
                  onClick={() => navigator.clipboard?.writeText(referralLink)}
                >
                  复制链接
                </button>
              </div>
            )}
            <div className="promoter-apply-actions">
              <button type="button" className="visa-portal-secondary-btn" onClick={() => navigate('/promoter')}>查看推广介绍页</button>
            </div>
          </section>
        ) : (
          <form className="promoter-apply-form" onSubmit={handleSubmit}>
            <div className="promoter-apply-intro">
              <h2>推广员申请资料</h2>
              <p>提交后会直接开通推广员身份，并生成您的专属推荐码。</p>
            </div>

            <label className="visa-portal-field">
              <span>微信号</span>
              <input
                type="text"
                value={form.wechat}
                onChange={(event) => updateField('wechat', event.target.value)}
                placeholder="请输入微信号"
              />
            </label>

            <label className="visa-portal-field">
              <span>手机号</span>
              <input
                type="tel"
                value={form.phone}
                onChange={(event) => updateField('phone', event.target.value)}
                placeholder="请输入手机号"
              />
            </label>

            <div className="visa-portal-field">
              <span>主要推广渠道</span>
              <div className="promoter-channel-options">
                {CHANNEL_OPTIONS.map((option) => (
                  <label key={option} className="promoter-channel-option">
                    <input
                      type="checkbox"
                      checked={form.channels.includes(option)}
                      onChange={() => toggleChannel(option)}
                    />
                    <span>{option}</span>
                  </label>
                ))}
              </div>
            </div>

            <label className="visa-portal-field">
              <span>客户资源说明</span>
              <textarea
                value={form.note}
                onChange={(event) => updateField('note', event.target.value)}
                placeholder="例如：身边有想咨询新西兰留学、出国劳务、签证办理或移民规划的朋友。"
                rows={5}
              />
            </label>

            {submitState.error && <p className="visa-portal-status visa-portal-status--error">{submitState.error}</p>}

            <button type="submit" className="visa-portal-primary-btn" disabled={submitState.loading}>
              {submitState.loading ? '正在提交...' : '提交申请'}
            </button>
          </form>
        )}
      </section>
    </main>
  )
}

export default PromoterRegisterPage
