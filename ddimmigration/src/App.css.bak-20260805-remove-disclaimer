.visa-repeat-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.visa-repeat-card-head strong {
  color: #16324f;
  font-size: 15px;
}

.visa-link-btn {
  padding: 0;
  border: none;
  background: transparent;
  color: #b42318;
