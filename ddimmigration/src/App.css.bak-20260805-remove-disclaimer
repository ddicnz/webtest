}

.assessment-page-note {
  margin: 18px 0 0;
  font-size: 12px;
  line-height: 1.6;
  color: #777;
  text-align: center;
}

/* 签证个人信息表：分步骤填写 */
.visa-form-page {
  max-width: 1180px;
}

.visa-form-page--portal {
  padding-top: 210px;
}

.visa-form-heading {
  margin: 0 auto 24px;
  max-width: 820px;
  text-align: center;
}

.visa-eyebrow {
  margin: 0 0 8px;
  color: var(--nav-bg);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.visa-form-heading h1 {
  margin: 0 0 12px;
  color: #16324f;
  font-size: 30px;
  line-height: 1.25;
}

.visa-form-heading p {
  margin: 0;
  color: #59636e;
  font-size: 15px;
  line-height: 1.75;
}

.visa-form-portal-actions {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 14px;
}

.visa-form-portal-actions .visa-secondary-btn {
  width: auto;
  min-height: 36px;
  padding: 7px 13px;
  border-radius: 6px;
  font-size: 14px;
}

.visa-form-shell {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  gap: 22px;
  align-items: start;
}

.visa-stepper {
  position: sticky;
  top: 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.visa-progress {
  padding: 16px;
  border: 1px solid rgba(91, 163, 198, 0.28);
  border-radius: 8px;
  background: #eef7fb;
}

.visa-progress span,
.visa-progress strong {
  display: inline-block;
  color: #16324f;
  font-size: 14px;
}

.visa-progress strong {
  float: right;
}

.visa-progress-track {
  clear: both;
  height: 8px;
  margin-top: 12px;
  overflow: hidden;
  border-radius: 999px;
  background: #d5e8f0;
}

.visa-progress-track div {
  height: 100%;
  border-radius: inherit;
  background: var(--nav-bg);
  transition: width 0.2s ease;
}

.visa-step {
  display: grid;
  grid-template-columns: 34px 1fr;
  gap: 2px 10px;
  width: 100%;
  padding: 12px;
  border: 1px solid #d8e1e8;
  border-radius: 8px;
  background: #fff;
  color: #243447;
  text-align: left;
  cursor: pointer;
  font-family: inherit;
  transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
}

.visa-step span {
  grid-row: span 2;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #edf2f7;
  color: #415466;
  font-size: 13px;
  font-weight: 800;
}

.visa-step strong {
  font-size: 14px;
  line-height: 1.2;
}

.visa-step small {
  color: #6f7d8a;
  font-size: 12px;
  line-height: 1.35;
}

.visa-step--active {
  border-color: rgba(91, 163, 198, 0.85);
  background: #f7fcff;
  box-shadow: 0 4px 14px rgba(91, 163, 198, 0.14);
}

.visa-step--active span,
.visa-step--done span {
  background: var(--nav-bg);
  color: #fff;
}

.visa-form-card {
  min-width: 0;
  padding: 22px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 8px;
  background: #fff;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
}

.visa-current-step {
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid #e8edf2;
  scroll-margin-top: 170px;
}

.visa-current-step span {
  display: inline-block;
  margin-bottom: 6px;
  color: var(--nav-bg);
  font-size: 13px;
  font-weight: 800;
}

.visa-current-step h2 {
  margin: 0 0 6px;
  color: #16324f;
  font-size: 24px;
}

.visa-current-step p {
  margin: 0;
  color: #6f7d8a;
  font-size: 14px;
}

.visa-section-block {
  margin-bottom: 20px;
}

.visa-section-head {
  margin-bottom: 14px;
}

.visa-section-head h3 {
  margin: 0 0 6px;
  color: #243447;
  font-size: 18px;
}

.visa-section-head p {
  margin: 0;
  color: #6a7580;
  font-size: 13px;
  line-height: 1.6;
}

.visa-section-head .visa-section-note--highlight {
  display: inline-block;
  padding: 8px 10px;
  border-left: 4px solid #f2b705;
  border-radius: 6px;
  color: #5f4200;
  background: #fff6c7;
  font-weight: 800;
}

.visa-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.visa-grid--wide {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.visa-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
  min-width: 0;
}

.visa-field span,
.visa-choice-field p {
  margin: 0;
  color: #334155;
  font-size: 13px;
  font-weight: 700;
}

.visa-field input,
.visa-field textarea {
  width: 100%;
  min-width: 0;
  padding: 11px 12px;
  border: 1px solid #d0d7de;
  border-radius: 8px;
  color: #17212b;
  background: #fff;
  font: inherit;
  font-size: 14px;
  outline: none;
}

.visa-field textarea {
  resize: vertical;
  min-height: 86px;
}

.visa-field input:focus,
.visa-field textarea:focus {
  border-color: var(--nav-bg);
  box-shadow: 0 0 0 2px rgba(91, 163, 198, 0.18);
}

.visa-question-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 16px;
}

.visa-choice-field {
  padding: 14px;
  border: 1px solid #dfe6ed;
  border-radius: 8px;
  background: #fbfcfd;
}

.visa-choice-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.visa-choice {
  min-width: 72px;
  padding: 8px 12px;
  border: 1px solid rgba(91, 163, 198, 0.32);
  border-radius: 999px;
  background: #fff;
  color: var(--nav-bg);
  cursor: pointer;
  font: inherit;
  font-size: 14px;
  font-weight: 700;
}

.visa-choice--active {
  background: var(--nav-bg);
  color: #fff;
}

.visa-repeat-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.visa-repeat-card {
  padding: 16px;
  border: 1px solid #dfe6ed;
