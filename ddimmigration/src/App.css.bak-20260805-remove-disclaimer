  margin-top: 4px;
  color: #71818e;
  font-size: 12px;
}

.visa-portal-saved-material-actions {
  display: flex;
  gap: 10px;
}

.visa-portal-saved-material-actions a {
  color: #2f829c;
  font-size: 13px;
  font-weight: 800;
  text-decoration: none;
}

.visa-portal-saved-material-actions button {
  padding: 0;
  border: 0;
  background: transparent;
  color: #b2342c;
  font: inherit;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
}

.visa-portal-saved-material-actions .visa-material-rename-btn {
  color: #2f829c;
}

.visa-portal-saved-material-actions a:hover,
.visa-portal-saved-material-actions button:hover {
  text-decoration: underline;
}

.visa-material-delete-backdrop {
  position: fixed;
  z-index: 1200;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(10, 35, 54, 0.52);
}

.visa-material-delete-dialog {
  width: min(100%, 440px);
  padding: 26px;
  border: 1px solid #dbe4e9;
  border-radius: 6px;
  background: #fff;
  box-shadow: 0 18px 50px rgba(10, 35, 54, 0.24);
}

.visa-material-delete-dialog h2 {
  margin: 0 0 14px;
  color: #17354f;
  font-size: 22px;
}

.visa-material-delete-dialog p {
  margin: 0;
  color: #526675;
  line-height: 1.65;
}

.visa-material-delete-dialog strong {
  display: block;
  overflow-wrap: anywhere;
  color: #253f54;
}

.visa-material-delete-dialog .visa-material-delete-warning {
  margin-top: 10px;
  color: #9a4139;
  font-size: 13px;
}

.visa-material-delete-dialog .visa-material-delete-error {
  margin-top: 14px;
  padding: 9px 11px;
  border: 1px solid #f2b8b5;
  border-radius: 5px;
  background: #fff1f0;
  color: #a52a24;
  font-size: 13px;
}

.visa-material-delete-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 22px;
}

.visa-material-delete-actions button {
  min-height: 42px;
}

.visa-material-delete-confirm {
  padding: 10px 18px;
  border: 1px solid #b2342c;
  border-radius: 5px;
  background: #b2342c;
  color: #fff;
  font-weight: 800;
  cursor: pointer;
}

.visa-material-rename-dialog label {
  display: block;
  margin: 18px 0 7px;
  color: #253f54;
  font-size: 14px;
  font-weight: 800;
}

.visa-material-rename-dialog input {
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid #bdcdd7;
  border-radius: 5px;
  color: #17354f;
  font: inherit;
}

.visa-material-rename-dialog input:focus {
  border-color: #2f829c;
  outline: 2px solid rgba(47, 130, 156, 0.16);
}

.visa-material-rename-dialog .visa-material-rename-help {
  margin-top: 7px;
  color: #71818e;
  font-size: 12px;
}

.visa-material-rename-confirm {
  padding: 10px 18px;
  border: 1px solid #2f829c;
  border-radius: 5px;
  background: #2f829c;
  color: #fff;
  font-weight: 800;
  cursor: pointer;
}

.visa-material-rename-confirm:disabled {
  cursor: wait;
  opacity: 0.62;
}

.visa-material-delete-confirm:disabled,
.visa-material-delete-actions .visa-secondary-btn:disabled {
  cursor: wait;
  opacity: 0.62;
}

.visa-portal-saved-materials-empty {
  margin: 0;
  color: #83919c;
  font-size: 13px;
}

.visa-portal-material-card-actions {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 16px;
  padding-top: 2px;
}

.visa-portal-material-card-actions p {
  margin: 0;
  color: #71818e;
  font-size: 13px;
}

.visa-portal-material-status {
  grid-column: 1 / -1;
  margin: 0;
  padding: 10px 12px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
}

.visa-portal-material-status--success {
  border: 1px solid #acd8c5;
  background: #edf8f3;
  color: #24644f;
}

.visa-portal-material-status--error {
  border: 1px solid #f2b8b5;
  background: #fff1f0;
  color: #a52a24;
}

.visa-portal-material-status--uploading {
  border: 1px solid #b8d8e4;
  background: #edf7fa;
  color: #285d70;
}

@media (max-width: 820px) {
  .visa-form-page--portal {
    padding-top: 188px;
  }

  .visa-portal-page {
    min-height: 0;
    padding: 188px 18px 56px;
  }

  .visa-portal-login-shell {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .visa-portal-login-intro {
    max-width: none;
  }

  .visa-portal-login-intro h1,
  .visa-portal-dashboard-head h1 {
    font-size: 30px;
  }

  .visa-portal-security-note {
    margin-top: 22px;
  }

  .visa-portal-login-card {
    min-height: 0;
    padding: 26px 20px;
  }

  .visa-portal-dashboard-head {
    flex-direction: column;
  }

  .visa-portal-dashboard-grid {
    grid-template-columns: 1fr;
  }

  .visa-portal-material-card {
    grid-template-columns: 1fr;
  }

  .visa-portal-file-list li {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .visa-portal-saved-material-list li {
    grid-template-columns: 50px minmax(0, 1fr);
  }

  .visa-portal-material-preview {
    width: 50px;
    height: 46px;
  }

  .visa-portal-saved-material-actions {
    grid-column: 2;
    flex-wrap: wrap;
  }

  .visa-material-delete-dialog {
    padding: 22px 18px;
  }

  .visa-portal-material-card-actions {
    align-items: stretch;
    flex-direction: column;
  }
}

@media (max-width: 800px) {
  .admin-stats {
    grid-template-columns: 1fr;
  }

  .admin-lead-grid {
    grid-template-columns: 1fr;
  }

  .admin-advice--base,
  .admin-advice--ai {
    grid-column: 1;
  }
}

@media (max-width: 960px) {
  .contact-layout {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .contact-title {
    font-size: 36px;
  }

  .contact-details,
  .contact-advisors {
    font-size: 20px;
  }
}

@media (max-width: 900px) {
  .page-with-sidebar {
    flex-direction: column;
  }

  /* 小屏时主内容先显示，侧栏（资质认证+二维码）后显示 */
  .page-with-sidebar .main-area {
    order: -1;
  }

  .page-with-sidebar .left-sidebar {
    order: 0;
  }

  .left-sidebar {
    width: 100%;
    position: static;
    padding: 16px 0;
  }

  .sidebar-card {
    max-width: 280px;
    margin: 0 auto;
  }
}

@media (max-width: 720px) {
  .advisors-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}

/* Footer 页脚 */
.site-footer {
  background: #0b263d;   /* 深蓝，与顶部条一致 */
  color: #fff;
  margin-top: 64px;
}

.footer-content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 24px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 40px;
  align-items: start;
  text-align: left;      /* 页脚文字整体靠左 */
}

.footer-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-contact {
  font-size: 14px;
  line-height: 1.8;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.contact-icon {
  font-size: 16px;
  flex-shrink: 0;
  margin-top: 2px;
}

.footer-map {
  height: 280px;
  border-radius: 8px;
  overflow: hidden;
}

.footer-map iframe {
  width: 100%;
  height: 100%;
  border: none;
}

.footer-qrcodes {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 12px;
  align-items: start;
  justify-items: start;
}

.qrcode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.qrcode-img {
  width: 82px;
  height: 82px;
  object-fit: contain;
  border-radius: 4px;
}

.qrcode-label {
  margin: 0;
  font-size: 12px;
  color: #fff;
}

.footer-copyright {
  background: #0b263d;
  padding: 16px 24px;
  text-align: left;      /* 版权行也靠左 */
}

.footer-copyright {
  background: var(--nav-bg);
  padding: 16px 24px;
  text-align: center;
}

.footer-copyright p {
  margin: 0;
  font-size: 12px;
  color: #fff;
}

@media (max-width: 968px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .footer-map {
    height: 240px;
  }
}

/* 后台客户管理使用与客户资料中心一致的页面壳层。 */
.admin-portal-page {
  width: 100%;
  max-width: none;
  min-height: 100vh;
  padding: 210px 28px 84px;
  background: #f3f7f9;
  color: #172f45;
}

.admin-portal-shell {
  width: min(100%, 1040px);
  margin: 0 auto;
}

.admin-portal-head {
  margin-bottom: 26px;
}

.admin-portal-page .admin-tabs {
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: thin;
}

.admin-portal-page .admin-auth-form {
  max-width: 430px;
  margin: 28px 0 0;
  padding: 28px;
  border-color: #d7e1e7;
  border-radius: 8px;
  box-shadow: 0 14px 34px rgba(16, 47, 73, 0.08);
}

.admin-portal-page .admin-lead-card,
.admin-portal-page .admin-client-detail-head,
.admin-portal-page .admin-client-panel {
  border-color: #d5e0e6;
  border-radius: 8px;
  box-shadow: none;
}

.admin-materials-manager,
.admin-materials-manager .visa-portal-materials {
  width: 100%;
}

.admin-materials-manager .visa-portal-dashboard-head h1 {
  font-size: 28px;
}

.admin-materials-manager .visa-portal-materials-note--warning {
  margin: 0;
}

@media (max-width: 820px) {
  .admin-portal-page {
    min-height: 0;
    padding: 188px 18px 56px;
  }

  .admin-portal-page .admin-tabs {
    flex-wrap: nowrap;
  }

  .admin-portal-page .admin-tab-btn {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .admin-portal-page .admin-auth-form {
    max-width: none;
    padding: 22px 18px;
  }

  .admin-materials-manager .visa-portal-dashboard-head h1 {
    font-size: 24px;
  }
}
