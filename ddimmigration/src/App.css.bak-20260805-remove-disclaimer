@font-face {
  font-family: "QingNiaoJianMeiHei";
  src: url("/fonts/QingNiaoHuaGuangJianMeiHei/QingNiaoHuaGuangJianMeiHei-2.ttf")
    format("truetype");
  font-weight: normal;
  font-style: normal;
}

/* 主题色：导航条初始透明、公司名淡蓝、链接蓝 */
:root {
  --nav-bar-bg: transparent;
  /* 滚动后顶栏与留学下拉共用，保证亮度一致 */
  --nav-bar-solid-bg: rgba(0, 0, 0, 0.35);
  --nav-bg: #5ba3c6;
  --nav-active: #87CEEB;
  --brand-green: #1b6b5c;
  --text-green: #1b6b5c;
}

.homepage {
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  background: #ffffff;
  overflow-x: hidden;
}

/* 顶部栏：深蓝背景，显示电话 / 邮箱 / 工作时间 */
.top-bar {
  background: #0b263d; /* 再深一档的蓝色 */
  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
}

.top-bar-inner {
  width: 100%;
  margin: 0;
  padding: 22px 24px; /* 再加一点垂直 padding，让 head 更高一些 */
  display: flex;
  align-items: center;
  justify-content: flex-start;   /* 顶部文字靠左 */
  font-size: 13px;
  color: #ffffff;
  gap: 24px;
  white-space: nowrap;
}

.top-bar-contact {
  display: flex;
  align-items: center;
  gap: 48px; /* 电话 / 邮箱 / 工作时间 之间稍分散 */
}

.logo-img {
  width: 58px;
  height: 58px;
  object-fit: contain;
  flex-shrink: 0;
  border-radius: 8px;
}

.company-name {
  margin: 0;
}

.company-zh {
  margin: 0;
  /* 使用你提供的青鸟华光简美黑字体 */
  font-family: "QingNiaoJianMeiHei", "PingFang SC", "Microsoft YaHei",
    -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 42px;
  font-weight: 900;
  color: #bde2f7; /* 再浅一点的蓝色 */
  line-height: 1.2;
  letter-spacing: 0.08em; /* 稍微拉开字距，更有设计感 */
}

.company-en {
  margin: 4px 0 0;
  font-size: 18px;
  font-weight: 700;
  color: #bde2f7; /* 英文名同样用更浅的蓝色 */
  font-family: "QingNiaoJianMeiHei", "PingFang SC", "Microsoft YaHei",
    -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.contact {
  display: flex;
  align-items: center;
  gap: 8px;
}

.phone-icon {
  font-size: 18px;
}

.phone-num {
  color: #1e5f8a; /* 与“新西兰嘀嘀移民咨询公司”同色 */
  font-weight: 700;
  font-size: 16px;
  text-decoration: none;
}

.phone-num:hover {
  text-decoration: underline;
}


.header-shell {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 120;
}

/* 导航栏：深色半透明背景，白字 */
.nav-bar {
  width: 100%;
  position: static;
  background: var(--nav-bar-bg);
  height: 88px; /* 导航栏整体高度 */
  display: flex;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.25); /* 底部更淡的白线 */
  transition: background 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}

.nav-bar--solid {
  /* 稍微加深的半透明背景，仍能看到下方图片 */
  background: var(--nav-bar-solid-bg);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.nav-bar--portal {
  background: #0b263d;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
}

.nav-inner {
  width: 100%;
  height: 100%;           /* 和 nav-bar 一样高 */
  max-width: none;
  margin: 0;
  padding: 0 12px 0 20px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20px;              /* 缩小间距，让整行更紧凑 */
  flex-wrap: wrap;        /* 小屏时导航可换行 */
}

.nav-brand {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  flex-direction: row; /* 明确水平排列：logo 在左，公司名在右 */
  margin-right: 24px;  /* logo+公司名 与 导航链接之间留出间距 */
  height: 100%;       /* 和 nav-inner / nav-bar 保持同高 */
}

/* 导航栏内 brand 略缩小：logo 和公司名 */
.nav-bar .logo-img {
  width: 48px;
  height: 48px;
}
.nav-bar .company-zh {
  font-size: 26px;
  letter-spacing: 0.04em;
  color: #bde2f7;
}
.nav-bar .company-en {
  font-size: 15px;
  margin-top: 2px;
  color: #bde2f7;
}

/* 导航栏内实际包着 logo 和公司名的容器，强制与导航同高、左右并排 */
.brand {
  display: flex;
  align-items: center;
  height: 100%;     /* = nav-inner = nav-bar */
  gap: 12px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 0;
  flex: 0 0 auto;
  justify-content: flex-start; /* 导航链接紧跟在 brand 右侧，不再靠右对齐 */
}

.nav-link {
  color: #fff;
  text-decoration: none;
  padding: 12px 14px; /* 更紧凑，避免换行 */
  font-size: 15px;
  font-weight: 500;
  white-space: nowrap;
  transition: background 0.2s, color 0.2s, font-weight 0.2s;
}

.nav-link:hover {
  background: rgba(255, 255, 255, 0.1);
  color: #87CEEB;
}

.nav-link.active {
  background: transparent;
  font-weight: 800;
  color: #ffffff;
}

.nav-link-disabled {
  cursor: default;
}


/* 留学专栏：桌面端悬停下拉 */
.nav-item--dropdown {
  position: relative;
  align-self: stretch;
  display: flex;
  align-items: stretch;
}

.nav-link--dropdown-trigger {
  display: inline-flex !important;
  align-items: center;
  gap: 4px;
}

.nav-dropdown-caret {
  font-size: 10px;
  opacity: 0.85;
  line-height: 1;
  margin-top: 2px;
}

/* 与顶栏同色同亮度：不用 backdrop-filter（会显更黑）；solid 与 .nav-bar--solid 共用变量 */
.nav-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 240px;
  margin: 0;
  padding: 8px 0;
  list-style: none;
  /* 顶栏未 solid 时较透，下拉略浅，避免整块比 nav 更「闷」 */
  background: rgba(0, 0, 0, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-top: none;
  border-radius: 0 0 10px 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-4px);
  transition:
    opacity 0.48s cubic-bezier(0.33, 1, 0.68, 1),
    visibility 0.48s cubic-bezier(0.33, 1, 0.68, 1),
    transform 0.48s cubic-bezier(0.33, 1, 0.68, 1),
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
  z-index: 300;
  pointer-events: none;
}

.nav-bar--solid .nav-dropdown {
  background: var(--nav-bar-solid-bg);
  border-color: rgba(255, 255, 255, 0.25);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.nav-item--dropdown:hover .nav-dropdown,
.nav-item--dropdown:focus-within .nav-dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.nav-dropdown-link {
  display: block;
  padding: 10px 18px;
  color: rgba(255, 255, 255, 0.95);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
  transition: background 0.15s, color 0.15s;
}

.nav-dropdown-link:hover {
  background: rgba(255, 255, 255, 0.12);
  color: #87ceeb;
}

.nav-dropdown-link.active {
  background: rgba(255, 255, 255, 0.08);
  font-weight: 700;
  color: #fff;
}

/* 移动端：留学专栏 — 主导航一行，子项在右侧滑出面板 */
.nav-mobile-study-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  font: inherit;
  font-weight: 500;
  text-align: left;
  cursor: pointer;
  border: none;
  background: transparent;
  font-family: inherit;
}
.nav-mobile-study-trigger-chevron {
  opacity: 0.75;
  font-size: 1.25rem;
  line-height: 1;
  flex-shrink: 0;
  margin-left: 8px;
}

.nav-mobile-subpanel {
  display: none;
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(300px, 88vw);
  max-width: 100%;
  background: #0b263d;
  z-index: 202;
  box-shadow: -4px 0 24px rgba(0, 0, 0, 0.35);
  padding: 20px 0 24px;
  box-sizing: border-box;
  transform: translateX(100%);
  transition: transform 0.28s ease;
  pointer-events: none;
  visibility: hidden;
}
.nav-mobile-subpanel.nav-mobile-subpanel--open {
  transform: translateX(0);
  pointer-events: auto;
  visibility: visible;
}
.nav-mobile-subpanel-header {
  padding: 8px 16px 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  margin-bottom: 8px;
}
.nav-mobile-subpanel-back {
  display: block;
  padding: 8px 0 12px;
  border: none;
  background: transparent;
  color: rgba(255, 255, 255, 0.85);
  font-size: 15px;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
}
.nav-mobile-subpanel-back:hover {
  color: #fff;
}
.nav-mobile-subpanel-title {
  display: block;
  font-size: 17px;
  font-weight: 700;
  color: #fff;
}
.nav-mobile-subpanel-links {
  padding: 0 16px;
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.nav-mobile-subpanel-link {
  border-bottom-color: rgba(255, 255, 255, 0.1);
}

/* 小屏：汉堡菜单按钮 + 下方「导航」小字（仅手机端显示） */
.nav-menu-btn-wrap {
  display: none;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  margin-right: 12px;
}
.nav-menu-btn {
  display: none;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  cursor: pointer;
  color: #fff;
}
.nav-menu-btn-line {
  display: block;
  width: 22px;
  height: 2px;
  background: currentColor;
  border-radius: 1px;
}
.nav-menu-btn-label {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 2px;
}

/* 小屏：展开的菜单（遮罩 + 侧边面板） */
.nav-mobile-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}
.nav-mobile-menu {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 280px;
  max-width: 85vw;
  background: #0b263d;
  z-index: 201;
  box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
  padding: 20px 0 24px;
  box-sizing: border-box;
}
.nav-mobile-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 40px;
  height: 40px;
  border: none;
  background: transparent;
  color: #fff;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
  padding: 0;
}
.nav-mobile-links {
  display: flex;
  flex-direction: column;
  margin-top: 48px;
  padding: 0 16px;
}
.nav-mobile-link {
  display: block;
  padding: 14px 12px;
  color: #fff;
  text-decoration: none;
  font-size: 16px;
  font-weight: 500;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.nav-mobile-link:hover,
.nav-mobile-link.active {
  background: rgba(255, 255, 255, 0.1);
  font-weight: 700;
}

/* 小屏：导航栏内的 logo+公司名（仅手机端显示） */
.nav-brand-mobile {
  display: none;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

/* 手机端：显示汉堡 + logo/名称，隐藏横向滚动的链接 */
@media (max-width: 900px) {
  .nav-bar {
    position: relative;
    flex-direction: row;
    align-items: center;
    min-height: 88px;
    height: 88px;
    padding: 0 12px 0 20px;
  }
  .nav-menu-btn-wrap {
    display: flex;
  }
  .nav-menu-btn {
    display: flex;
  }
  .nav-brand-mobile {
    display: flex;
  }
  .nav-brand-mobile .logo-img {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .nav-brand-mobile .company-zh {
    font-size: 18px;
  }
  .nav-brand-mobile .company-en {
    font-size: 11px;
  }
  .nav-inner,
  .nav-scroll-hint {
    display: none !important;
  }
  .nav-mobile-overlay,
  .nav-mobile-menu {
    display: block;
  }
  .nav-mobile-subpanel {
    display: block;
  }
}

@media (min-width: 901px) {
  .nav-scroll-hint,
  .nav-inner-spacer {
    display: none;
  }
  .nav-menu-btn-wrap,
  .nav-menu-btn,
  .nav-brand-mobile {
    display: none !important;
  }
  .nav-mobile-overlay,
  .nav-mobile-menu {
    display: none !important;
  }
  .nav-mobile-subpanel {
    display: none !important;
  }
}

/* 首页下方小字提示：滑动查看更多（仅手机端显示） */
.home-scroll-hint {
  display: none;
}
@media (max-width: 900px) {
  .home-scroll-hint {
    display: block;
    text-align: center;
    margin: 0;
    padding: 10px 16px;
    font-size: 12px;
    color: #666;
    background: #f5f5f5;
  }
}

/* 页面主体：左侧边栏 + 主内容区（除首页外各页一致）；小屏铺满宽度 */
.page-with-sidebar {
  display: flex;
  align-items: flex-start;
  gap: 48px;
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
  box-sizing: border-box;
}

.left-sidebar {
  flex-shrink: 0;
  width: 260px;
  padding: 24px 0 48px;
  position: sticky;
  top: 20px;
}

.sidebar-card {
  background: #fff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 8px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.sidebar-cert {
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.sidebar-cert-title {
  margin: 0 0 10px;
  font-size: 18px;
  font-weight: 700;
  color: #222;
}

.sidebar-cert-img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 4px;
}

.sidebar-qr-block {
  margin-bottom: 16px;
}

.sidebar-qrcode {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 4px;
}

.sidebar-qrcode-btn {
  margin-top: 10px;
  background: var(--nav-bg);
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  text-align: center;
  padding: 8px 12px;
  border-radius: 6px;
}

.sidebar-contact {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  font-size: 12px;
  line-height: 1.75;
  color: #222;
}

.sidebar-contact-row {
  margin: 4px 0;
}

.sidebar-contact-label {
  color: #111;
  font-weight: 700;
}

.main-area {
  flex: 1;
  min-width: 0;
}

/* Hero 区域 */
.hero {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

/* ========== 各页顶部图亮度（在这里改数值） ========== */
/* 首页 */
.hero .hero-bg {
  filter: brightness(0.8);
}
/* 除首页外各页默认亮度 */
.about-hero .about-hero-bg {
  filter: brightness(0.8);
}
/* 以下可单独改：关于我们 | 招聘信息 | 专业团队 | 核心业务 | 成功案例 | 企业相册 | 移民资讯 | 联络我们 */
.about-hero--about .about-hero-bg { filter: brightness(0.55); }
.about-hero--jobs .about-hero-bg { filter: brightness(0.8); }
.about-hero--team .about-hero-bg { filter: brightness(0.6); }
.about-hero--services .about-hero-bg { filter: brightness(0.8); }
.about-hero--cases .about-hero-bg { filter: brightness(0.7) blur(0.1px); background-size: 100%; }
.about-hero--album .about-hero-bg { filter: brightness(0.8); background-position: center 50%; }
.about-hero--news .about-hero-bg { filter: brightness(0.55); background-position: center 30%; }
.about-hero--contactus .about-hero-bg { filter: brightness(0.75); }
.about-hero--faq .about-hero-bg { filter: brightness(0.7); }
.about-hero--study .about-hero-bg { filter: brightness(0.65); }

/* 关于我们页顶部图片：高度约半屏，位于导航下方 */
.about-hero {
  position: relative;
  width: 100%;
  min-height: 50vh;
  overflow: hidden;
}

.about-hero-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.hero-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.7);
  color: #333;
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.hero-arrow:hover {
  background: rgba(255, 255, 255, 0.95);
}

.hero-arrow-left {
  left: 20px;
}

.hero-arrow-right {
  right: 20px;
}

/* 首页 Hero：主 CTA + 免费评估纵向排列（同宽：inline-grid 列宽 = 最宽子项） */
.hero-cta-stack {
  position: absolute;
  left: 45%;
  top: 70%;
  transform: translateY(-50%);
  z-index: 2;
  display: inline-grid;
  grid-template-columns: auto;
  gap: 14px;
  max-width: min(92vw, 520px);
}

/* 首页 Hero 左侧 CTA：跳转联络我们 */
.hero-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 25px;
  border: none;
  border-radius: 8px;
  background: linear-gradient(90deg, #9B7BCB 0%, #6fd9ff 100%);
  color: #fff;
  font-size: 17px;
  font-weight: 600;
  text-decoration: none;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  transition: transform 0.2s, box-shadow 0.2s;
}

.hero-cta-btn:hover {
  transform: scale(1.02);
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
}

/* 与主 CTA 同宽、同色系；字号与内边距略小一点 */
.hero-cta-btn--compact {
  padding: 12px 25px;
  font-size: 17px;
  gap: 7px;
  box-shadow: 0 3px 16px rgba(0, 0, 0, 0.22);
}

.hero-cta-btn--compact .hero-cta-arrow {
  font-size: 16px;
}

.hero-cta-text {
  white-space: nowrap;
}

.hero-cta-arrow {
  font-size: 18px;
  line-height: 1;
}

@media (max-width: 768px) {
  .hero-cta-stack {
    left: 20px;
  }

  .hero-cta-btn {
    padding: 11px 20px;
    font-size: 14px;
  }

  .hero-cta-btn--compact {
    padding: 10px 20px;
    font-size: 14px;
    gap: 6px;
  }

  .hero-cta-btn--compact .hero-cta-arrow {
    font-size: 14px;
  }

  .hero-cta-text {
    white-space: normal;
  }
}

/* 主体内容 */
.main-content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 48px 24px 64px;
  min-height: 280px;
}

.section-title {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
  color: #6bb3d8; /* 淡蓝色 */
  text-align: center;
}

